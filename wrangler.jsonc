{
  "name": "elorrietatrack-estable",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "build": {
    "command": "node scripts/check-new-installation.mjs && npm run build"
  },
  "main": "server/worker.js",
  "d1_databases": [
    {
      "binding": "AUTH",
      "database_name": "elorrietatrack-estable-auth",
      "database_id": "PENDIENTE_NUEVA_BASE_DE_DATOS"
    }
  ],
  "account_id": "PENDIENTE_NUEVA_CUENTA"
}
