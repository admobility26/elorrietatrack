{
  "name": "elorrietatrack",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "build": {
    "command": "node scripts/check-new-installation.mjs && npm run build"
  },
  "main": "server/worker.js",
  "d1_databases": [
    {
      "binding": "AUTH",
      "database_name": "elorrietatrack-estable-auth",
      "database_id": "2c770bdc-780c-4dfe-b3a9-43a82991aac0"
    }
  ],
  "account_id": "a42daa5d5844f10ca43694aaba7ff82b",
  "vars": {
    "PUBLIC_ORIGIN": "https://elorrietatrack.admobility26.workers.dev"
  },
  "workers_dev": true
}
