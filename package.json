{
  "name": "elorrieta-track",
  "version": "1.5.1",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/sync-help.mjs && node scripts/sync-legal.mjs && vite build",
    "preview": "vite preview",
    "desktop:dev": "node scripts/check-new-installation.mjs && node scripts/electron-dev.cjs",
    "icon:mac": "node scripts/make-icon.cjs",
    "package:mac": "node scripts/check-new-installation.mjs && npm run icon:mac && npm run build && electron-builder --mac dmg --arm64 --publish never",
    "prepare": "npm run build",
    "package:win": "node scripts/check-new-installation.mjs && npm run build && electron-builder --win nsis --x64 --publish never",
    "test": "node tests/board-model.mjs && node tests/edition.mjs && node tests/trajectory-edit.mjs && node tests/trajectory-board.mjs",
    "test:recording": "node tests/trajectory-pause.mjs && node tests/board-recording.mjs",
    "test:desktop": "node tests/desktop-edition.mjs",
    "test:licensing": "node tests/licensing.mjs",
    "domain": "node scripts/configure-domain.mjs",
    "test:premium": "node tests/premium-workspace.mjs && node tests/premium-movie.mjs && node tests/premium-desktop.mjs",
    "test:domain": "node tests/domain-migration.mjs",
    "test:assembly": "node tests/review-assembly.mjs && node tests/assembly-movie.mjs && node tests/assembly-workspace.mjs",
    "test:fast": "node tests/fast-movie.mjs",
    "test:web-expiry": "node tests/web-expiry.mjs && node tests/web-expiry-ui.mjs"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "maplibre-gl": "^6.13.0",
    "mediabunny": "^1.62.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "vite": "^6.3.5"
  },
  "allowScripts": {
    "electron@44.7.0": true
  },
  "build": {
    "appId": "com.admobility26.elorrietatrack",
    "productName": "ElorrietaTrack Estable",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "ElorrietaTrack usa el micrófono si eliges grabar una explicación.",
        "NSBluetoothAlwaysUsageDescription": "ElorrietaTrack Premium usa Bluetooth para conectar con RaceBox Mini o Mini S y recibir los datos de la práctica."
      }
    },
    "dmg": {
      "title": "ElorrietaTrack Estable",
      "artifactName": "ElorrietaTrack-Estable-${version}-Mac-AppleSilicon.dmg",
      "contents": [
        {
          "x": 140,
          "y": 170,
          "type": "file"
        },
        {
          "x": 420,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "copyright": "Copyright © 2026 Aitor Delgado Martínez · AD Mobility",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "ElorrietaTrack-Estable-${version}-Windows-x64-Setup.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "afterPack": "scripts/after-pack.cjs"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "Aitor Delgado Martínez (AD Mobility)",
  "description": "ElorrietaTrack: trayectorias y pizarra didáctica para formación vial"
}
